{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nunya",
  "mainBinaryName": "Nunya",
  "version": "0.1.0",
  "identifier": "com.nunyavpn.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Nunya",
        "width": 1040,
        "height": 744,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "copyright": "",
    "shortDescription": "A safe, fast, reliable VPN client for the Nunya core",
    "externalBin": [
      "binaries/nunya-core"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
